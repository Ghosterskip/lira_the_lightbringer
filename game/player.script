local dialogue_data = require("data.dialogue_data")
local fmod_audio = require("fmod_audio.fmod_audio")
local fmod_banks = require("fmod_audio.fmod_banks")
local msg_shake = hash("shake")
go.property("camera_url", msg.url("/go#camera_follow"))
local MAX_ENERGY = 6
local ENERGY_RECOVER_RATE = 0.5 -- Lanterns recovered per second (0.5 = 1 lantern every 2s)

-- Movement tweaks
local air_acceleration_factor = 0.8
local max_speed = 450
local gravity = -1900
local jump_takeoff_speed = 900

-- Dash tweaks
local dash_speed = 1100       -- burst speed in pixels/sec
local dash_duration = 0.20   -- how long the dash lasts (seconds)
local dash_cooldown = 0.25    -- brief pause before dashing again
local dash_end_damping = 0.5  -- keeps 50% momentum when dash finishes so it feels smooth

-- Animation & Coyote Time tweaks
local ground_grace_time = 0.15
local anim_playback_rate = 0.75

-- Pre-hashed IDs
local msg_contact_point_response = hash("contact_point_response")
local group_obstacle = hash("ground")
local input_left = hash("left")
local input_right = hash("right")
-- local fmod = require("fmod.studio")

local input_up = hash("up")
local input_down = hash("down")
local input_jump = hash("jump")
local input_dash = hash("dash")

local anim_walk = hash("running")
local anim_idle = hash("idle")
local anim_jump = hash("jump_air")
local anim_fall = hash("jump_air")
local anim_dash = hash("tether_dash")

local trying_to_dash = false

local function sync_energy_hud(self)
	local whole_lanterns = math.floor(self.energy)
	if whole_lanterns ~= self.displayed_energy then
		self.displayed_energy = whole_lanterns
		msg.post("/hud#hud", "update_energy", { current = whole_lanterns })
	end
end

-- Call this whenever Lira casts an ability
local function try_spend_energy(self, cost)
	if self.energy < cost then
		msg.post("/hud#hud", "show_error", { text = "Not enough energy!" })
		if trying_to_dash then
			self.can_dash = false
		end
		return false
	end

	self.energy = self.energy - cost
	sync_energy_hud(self)
	return true
end

function init(self)
	msg.post(".", "acquire_input_focus")
	fmod_banks.load({ "master", "strings" })
	self.music = fmod_audio.play_loop("event:/level_music")
	

	self.velocity = vmath.vector3(0, 0, 0)
	self.facing_direction = 1
	self.correction = vmath.vector3()
	self.ground_contact = false
	self.wall_contact = false
	self.ground_timer = 0
	self.anim = nil

	-- Track held directional keys for 8-way aiming
	self.input_dir = vmath.vector3(0, 0, 0)

	-- Dash state variables
	self.is_dashing = false
	self.dash_timer = 0
	self.dash_cooldown_timer = 0
	self.can_dash = true
	self.dash_dir = vmath.vector3(1, 0, 0)

	msg.post("game:/go1#dialogue", "start_dialogue", { dialogue_id = "trapped_inside_the_cave" })

	self.energy = MAX_ENERGY
	self.displayed_energy = MAX_ENERGY
	msg.post("/hud#hud", "update_energy", { current = self.displayed_energy })
end

local function play_animation(self, anim)
	if self.anim ~= anim then
		sprite.play_flipbook("#sprite", anim, nil, { playback_rate = anim_playback_rate })
		self.anim = anim
	end
end

local function update_animations(self)
	if self.facing_direction ~= 0 then
		sprite.set_hflip("#sprite", self.facing_direction < 0)
	end

	if self.is_dashing then
		fmod_audio.play_one_shot("event:/dash")
		play_animation(self, anim_dash)
		msg.post(self.camera_url, msg_shake, { intensity = 5, duration = 0.14 })
		return
	end

	if self.ground_timer > 0 then
		if math.abs(self.velocity.x) < 1 then
			play_animation(self, anim_idle)
		else
			play_animation(self, anim_walk)
		end
	else
		if self.velocity.y > 0 then
			play_animation(self, anim_jump)
		else
			play_animation(self, anim_fall)
		end
	end
end

local function start_dash(self)
	trying_to_dash = true
	try_spend_energy(self, 2)
	if not self.can_dash or self.is_dashing or self.dash_cooldown_timer > 0 then
		return
	end
	trying_to_dash = false
	-- Determine dash direction from currently held keys
	local dir = vmath.vector3(self.input_dir.x, self.input_dir.y, 0)

	-- If no direction keys are held, dash forward in the direction Lira is facing
	if vmath.length_sqr(dir) == 0 then
		dir.x = self.facing_direction
	else
		-- Normalize so diagonal dashes (e.g. Up + Right) aren't faster than straight dashes
		dir = vmath.normalize(dir)
	end

	self.is_dashing = true
	self.can_dash = false
	self.dash_timer = dash_duration
	self.dash_dir = dir
	self.velocity = dir * dash_speed
	self.ground_timer = 0

	if dir.x ~= 0 then
		self.facing_direction = dir.x > 0 and 1 or -1
	end
end

function update(self, dt)
	if self.music and self.music:get_playback_state() == fmod.STUDIO_PLAYBACK_STOPPED then
		self.music:start()
	end
	if self.ground_timer > 0 then
		self.ground_timer = self.ground_timer - dt
	end

	if self.dash_cooldown_timer > 0 then
		self.dash_cooldown_timer = self.dash_cooldown_timer - dt
	end

	update_animations(self)
	if self.energy < MAX_ENERGY then
		self.energy = math.min(MAX_ENERGY, self.energy + ENERGY_RECOVER_RATE * dt)
		sync_energy_hud(self)
	end
	
end

function fixed_update(self, dt)
	if self.is_dashing then
		-- Maintain constant dash velocity (no gravity during dash)
		self.velocity = self.dash_dir * dash_speed
		self.dash_timer = self.dash_timer - dt

		if self.dash_timer <= 0 then
			self.is_dashing = false
			self.dash_cooldown_timer = dash_cooldown
			-- Dampen velocity at the end of the dash so Lira doesn't launch into orbit
			self.velocity = self.velocity * dash_end_damping
		end
	else
		-- Normal gravity when not dashing
		self.velocity.y = self.velocity.y + gravity * dt
	end

	-- Move player
	local pos = go.get_position()
	pos = pos + self.velocity * dt
	go.set_position(pos)

	-- Reset volatile collision state
	self.correction = vmath.vector3()
	self.ground_contact = false
	self.wall_contact = false
end

local function handle_obstacle_contact(self, normal, distance)
	if distance > 0 then
		local push_normal = normal
		if normal.y > 0.7 then
			push_normal = vmath.vector3(0, 1, 0)
		elseif math.abs(normal.x) > 0.7 then
			push_normal = vmath.vector3(normal.x > 0 and 1 or -1, 0, 0)
		end

		local proj = vmath.project(self.correction, push_normal * distance)
		if proj < 1 then
			local comp = (distance - distance * proj) * push_normal
			go.set_position(go.get_position() + comp)
			self.correction = self.correction + comp
		end
	end

	-- Collided with a wall
	if math.abs(normal.x) > 0.7 then
		self.wall_contact = true
		if (normal.x > 0 and self.velocity.x < 0) or (normal.x < 0 and self.velocity.x > 0) then
			self.velocity.x = 0
		end
	end

	-- Collided with the ground
	if normal.y > 0.7 and self.velocity.y <= 0 then
		self.ground_contact = true
		self.ground_timer = ground_grace_time
		self.velocity.y = 0
		if not self.is_dashing then
			self.can_dash = true
		end
	end

	if normal.y < -0.5 and self.velocity.y > 0 then
		self.velocity.y = 0
	end
end

function on_message(self, message_id, message, sender)
	if message_id == msg_contact_point_response then
		if message.group == group_obstacle then
			handle_obstacle_contact(self, message.normal, message.distance)
		end
	end
end

local function jump(self)
	if self.ground_timer > 0 and not self.is_dashing then
		self.velocity.y = jump_takeoff_speed
		particlefx.play("#jump_dust")
		play_animation(self, anim_jump)
		self.ground_contact = false
		self.ground_timer = 0
	end
end

local function abort_jump(self)
	if self.velocity.y > 0 and not self.is_dashing then
		self.velocity.y = self.velocity.y * 0.5
	end
end

local function update_horizontal_walk(self)
	if self.is_dashing then
		return
	end

	local dir_x = self.input_dir.x
	if dir_x ~= 0 then
		self.facing_direction = dir_x
	end

	if self.ground_timer > 0 then
		self.velocity.x = max_speed * dir_x
	else
		self.velocity.x = max_speed * air_acceleration_factor * dir_x
	end
end

function on_input(self, action_id, action)
	if dialogue_data.in_active_dialogue then 
		return
	end
	-- Track horizontal input state cleanly even when opposing keys overlap
	if action_id == input_left then
		self.input_dir.x = action.released and 0 or -1
		update_horizontal_walk(self)
	elseif action_id == input_right then
		self.input_dir.x = action.released and 0 or 1
		update_horizontal_walk(self)
	elseif action_id == input_up then
		self.input_dir.y = action.released and 0 or 1
	elseif action_id == input_down then
		self.input_dir.y = action.released and 0 or -1
	elseif action_id == input_jump then
		if action.pressed then
			jump(self)
		elseif action.released then
			abort_jump(self)
		end
	elseif action_id == input_dash then
		if action.pressed then
			start_dash(self)
		end
	end
end

function final(self)
	if not fmod then
		return
	end

	fmod_banks.unload({ "master", "strings" })
	
end
