local defork = require("defork.defork")

local function show_node(self, node_id)
	if not node_id then
		-- No next node: hide the dialogue UI
		gui.set_enabled(gui.get_node("root"), false)
		self.active = false
		return
	end

	defork.setCurrentNode(node_id)

	-- 1. Get speaker name from the first Twine tag (or fallback)
	local tags = defork.getTags(node_id)
	local speaker = (tags and tags[1]) or "Unknown"

	-- 2. Get clean dialogue text (Twison links are stripped automatically)
	local text = defork.getText(node_id)

	-- 3. Update your existing GUI text nodes
	gui.set_text(self.name_node, speaker)
	gui.set_text(self.text_node, text)
end

function init(self)
	print(msg.url())
	msg.post(".", "acquire_input_focus")
	self.name_node = gui.get_node("character_label")
	self.text_node = gui.get_node("dialogue_content")
	self.active = false

	-- Load your Twison JSON (registered under Custom Resources in game.project)
	self.conversation = defork.load("/assets/dialogue/trapped_inside_the_cave.json")
	gui.set_enabled(gui.get_node("root"), false)
end

function on_message(self, message_id, message, sender)
	-- Triggered by an NPC or player script: msg.post("/gui#dialogue", "start_dialogue", { start_passage = "Guard_Start" })
	if message_id == hash("start_dialogue") then
		self.active = true
		gui.set_enabled(gui.get_node("root"), true)

		-- Find the passage ID matching the requested character's start passage name
		local start_id = defork.getStartNodeID()
		for id, passage in pairs(self.conversation.passages) do
			if passage.name == message.start_passage then
				start_id = id
				break
			end
		end
		show_node(self, start_id)
	end
end


function on_input(self, action_id, action)
	if not self.active then return end

	-- Advance to the next line on click or interact key
	if (action_id == hash("touch") or action_id == hash("confirm")) and action.pressed then
		local options = defork.getOptions() -- Linear links appear as option #1
		if options and #options > 0 then
			local next_node_id = defork.getOptionLink(1)
			show_node(self, next_node_id)
		else
			show_node(self, nil) -- End of conversation
		end
	end
end
