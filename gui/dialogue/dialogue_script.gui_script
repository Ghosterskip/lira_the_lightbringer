local defork = require("defork.defork")
local dialogue_data = require("data.dialogue_data")

local function show_node(self, node_id)
	if not node_id then
		gui.set_enabled(gui.get_node("root"), false)
		self.active = false
		dialogue_data.in_active_dialogue = false
		return
	end

	defork.setCurrentNode(node_id)

	local tags = defork.getTags(node_id)
	local speaker = (tags and tags[1]) or "Unknown"

	local text = defork.getText(node_id)

	gui.set_text(self.name_node, speaker)
	gui.set_text(self.text_node, text)
	dialogue_data.in_active_dialogue = true
end

function init(self)
	print(msg.url())
	msg.post(".", "acquire_input_focus")
	self.name_node = gui.get_node("character_label")
	self.text_node = gui.get_node("dialogue_content")
	self.active = false

	self.conversation = dialogue_data.dialogue_map[1].dialogue_resource
	gui.set_enabled(gui.get_node("root"), false)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("start_dialogue") then
		self.active = true
		gui.set_enabled(gui.get_node("root"), true)

		local start_id = defork.getStartNodeID()
		local active_dialogue = dialogue_data.retrieve_dialogue(message.dialogue_id)
		self.conversation = active_dialogue.dialogue_resource
		for id, passage in pairs(self.conversation.passages) do
			if passage.name == active_dialogue.start_passage then
				start_id = id
				break
			end
		end
		show_node(self, start_id)
	end
end


function on_input(self, action_id, action)
	if not self.active then return end

	-- Advance to the next line on click or interact key
	if dialogue_data.in_active_dialogue and (action_id == hash("touch") or action_id == hash("confirm")) and action.pressed then
		local options = defork.getOptions() -- Linear links appear as option #1
		if options and #options > 0 then
			local next_node_id = defork.getOptionLink(1)
			show_node(self, next_node_id)
		else
			show_node(self, nil) -- End of conversation
		end
	end
end
